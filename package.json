{
  "name": "dns-email-audit",
  "version": "1.0.0",
  "description": "Browser-based DNS and email security auditor — SPF, DKIM, DMARC, BIMI, MTA-STS, TLS-RPT, CAA and DNSSEC for up to 200 domains at once.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "node tools/serve.mjs",
    "update:dkim-selectors": "node tools/update-dkim-selectors.mjs",
    "update:psl": "node tools/update-psl.mjs",
    "build": "node tools/build-site.mjs",
    "build:fallback": "node tools/build-fallback.mjs",
    "check": "node tools/check-locales.mjs",
    "test": "node tools/check-locales.mjs && node tools/scoring.test.mjs",
    "test:scoring": "node tools/scoring.test.mjs"
  },
  "keywords": [
    "dns",
    "spf",
    "dkim",
    "dmarc",
    "dnssec",
    "bimi",
    "mta-sts",
    "email-security",
    "i18n"
  ],
  "engines": {
    "node": ">=18"
  }
}
